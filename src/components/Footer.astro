---
import { t, type Locale } from '~/i18n';

interface FooterLink {
  href: string;
  label: string;
}

interface Props {
  lang: Locale;
  // Empty until the imprint / privacy pages exist.
  legalLinks?: FooterLink[];
  contactEmail: string;
}

const { lang, legalLinks = [], contactEmail } = Astro.props;
const strings = t(lang);

const FOUNDED = 2026;
const currentYear = new Date().getFullYear();
const yearRange = currentYear > FOUNDED ? `${FOUNDED}–${currentYear}` : `${FOUNDED}`;
---

<!--
  The pronunciation respelling lives here by design: the handoff (§1) calls for
  it in the footer and in email signatures, so the two readings settle without
  anyone having to ask.
-->
<footer class="border-t border-hair mt-20">
  <div
    class="mx-auto max-w-(--container-content) px-6 md:px-10 py-14 grid gap-10 md:grid-cols-3 text-sm text-grey"
  >
    <div class="space-y-3">
      <p class="lockup text-ink">{strings.footer.pronunciationLabel}</p>
      <p>
        {strings.footer.pronunciation}
        <span class="text-ink/50">{strings.footer.pronunciationIpa}</span>
      </p>
    </div>

    <div class="space-y-3">
      <p class="lockup text-ink">{strings.footer.contact}</p>
      <p><a href={`mailto:${contactEmail}`} class="link-underline">{contactEmail}</a></p>
      <p>{strings.footer.location}</p>
    </div>

    {
      legalLinks.length > 0 && (
        <div class="space-y-3">
          <p class="lockup text-ink">{strings.footer.legal}</p>
          <ul class="space-y-1">
            {legalLinks.map((l) => (
              <li>
                <a href={l.href} class="link-underline">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="mx-auto max-w-(--container-content) px-6 md:px-10 pb-10 text-xs text-grey">
    © {yearRange} Faviens. {strings.footer.rights}
  </div>
</footer>
