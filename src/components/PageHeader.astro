---
interface Props {
  number?: string;
  heading: string;
  lead?: string;
}

const { number, heading, lead } = Astro.props;
---

<section class="px-6 md:px-10 pt-40 pb-24">
  <div class="mx-auto max-w-(--container-content)">
    {number && <p class="text-sm tracking-wider uppercase text-accent mb-4">{number}</p>}
    <h1 class="text-5xl md:text-7xl tracking-tighter font-medium leading-[0.95]">
      {heading}
    </h1>
    {lead && <p class="mt-6 max-w-2xl text-lg md:text-xl text-muted leading-relaxed">{lead}</p>}
  </div>
</section>
