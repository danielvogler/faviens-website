---
import MarkLockup from '~/components/marks/MarkLockup.astro';
import MarkGlobe from '~/components/marks/MarkGlobe.astro';

interface Props {
  descriptor: string;
  services: { prefix: string; items: readonly string[] };
  status: string;
  lead: string;
}

const { descriptor, services, status, lead } = Astro.props;

/* Capitals read optically larger than the lowercase this replaced, so the clamp
   is lower than the type size alone would suggest. */
const MARK_SIZE = 'text-[clamp(2.75rem,11vw,8.5rem)]';

/*
 * The descriptor is one string in the locale files and carries its own Roman
 * interpunct: "Agentic-KI-Beratung · Zürich". Set flat it is a single grey
 * line and the two halves, what we do and where we are, read as one. Split on
 * the divider the string already has: no locale change, and a string without a
 * divider still renders correctly as a single segment.
 */
const [discipline, ...rest] = descriptor.split('·').map((part) => part.trim());
const place = rest.join(' · ');
---

<!--
  The mark is the loudest thing on the screen and everything else steps down
  from it: ink for what we are, grey for where, hairline for structure. The
  status dot is the only motion in the composition and it is a two-second
  breath, not an animation.

  Everything above the rule that opens the contact block is centred, as one
  column: descriptor, mark, status, lead. The measure stays at 58ch and is
  centred within the container rather than widened, because a centred paragraph
  that runs past its measure is harder to read, not easier.
-->
<section class="relative min-h-screen flex flex-col justify-center px-6 md:px-10 pt-32 pb-20">
  <div class="mx-auto max-w-(--container-content) w-full">
    <p class="lockup flex items-center justify-center gap-3">
      <span class="text-ink">{discipline}</span>
      {
        place && (
          <>
            <span aria-hidden="true" class="h-px w-6 bg-hair" />
            <span class="text-grey">{place}</span>
          </>
        )
      }
    </p>

    <!--
      The lockup, not the wordmark alone: globe left, name right, on the
      brand package's horizontal numbers.

      `minSize` is a floor under the globe and not a style choice: it holds the
      globe at or above the 28px its strands stop reading below. The hero never
      gets near it, since the clamp's own floor puts the globe at 42px, but the
      floor is what makes that a guarantee rather than an observation.
    -->
    <h1 class="mt-10 flex justify-center">
      <MarkLockup class={MARK_SIZE} variant="full" minSize="1.75rem" />
    </h1>

    <!--
      One separator, used three times: the mark itself, at the smallest size it
      still reads at. Every point on this page is now the same object, so the
      separators, the status marker and the logo are one device rather than
      three similar ones.

      It is larger than the plain dot it replaces, and that is not a preference:
      below about 14px no arrangement of strands reads as a sphere, so a globe
      set at a dot's size is a smudge with extra bytes. Half the type size, with
      a 16px floor, is the smallest that still reads as the mark on a phone.

      The prefix is marked by colour alone now. That is a real trade: the line
      reads as four items rather than one governing three, and only the accent
      says otherwise.

      The separators are drawn rather than typed, so each is followed by a real
      space to keep the line extracting as four things rather than as one word.

      The prefix steps down to --color-accent-d below md. The accent measures
      3.9:1 on paper, which passes for large text and fails for normal: at the
      desktop size this line is large text and at the mobile size it is not.
      The darker token is 5.3:1 and passes at both.
    -->
    <p
      class="services mt-7 mx-auto max-w-[30ch] md:max-w-none text-center text-balance text-xl md:text-3xl tracking-[-0.02em] text-ink"
    >
      {
        [services.prefix, ...services.items].flatMap((word, index) => [
          index > 0 ? [<MarkGlobe variant="dot" class="sep" />, ' '] : '',
          index === 0 ? <span class="text-accent-d md:text-accent">{word}</span> : word,
        ])
      }
    </p>

    <!-- The 2.5rem left column is for section numbers only; a word set in it
         overruns into the copy. The status label stacks above the lead. -->
    <div class="mt-14 text-center">
      <p class="eyebrow text-accent-d flex items-center justify-center gap-2.5">
        <MarkGlobe variant="dot" class="status-dot" />
        {status}
      </p>
      <p
        class="mt-5 mx-auto max-w-(--container-measure) text-center text-lg md:text-xl text-ink/85 leading-relaxed"
      >
        {
          /* An array, not adjacent expressions: children in an array carry no text
            nodes between them, so no line break the formatter chooses can turn
            into a stray space around the mark. The spacing is the locale
            string's own. */
        }
        {lead}
      </p>
    </div>
  </div>
</section>

<style>
  /*
   * Drawn, not typed. Archivo's interpunct is a square, which reads as a
   * different family of shape from the mark it now sits under.
   *
   * A real space follows each one so the line still extracts as four things
   * rather than as one run-on word; the left margin is the gap in front, and
   * that trailing space is the gap behind.
   *
   * The floor is what keeps it legible: `0.4em` alone would be 8px against the
   * mobile type size, which is under the size a wound sphere reads at.
   */
  /*
   * `:global`, under a selector that is scoped. Astro puts its scope attribute
   * on the elements in this file's own template, and an `img` rendered by
   * MarkGlobe is not one of them, so a bare `.sep` here matches nothing at all.
   * The `.services` ancestor is in this template, so the rule stays scoped to
   * this component while still reaching the child.
   */
  .services :global(.sep) {
    --globe-size: max(1rem, 0.5em);
    /* The ink fills the box edge to edge, where the dot this replaces had its
       own whitespace built in, so both sides need the air stated. The trailing
       real space in the markup adds to the right side. Vertical centring is
       MarkGlobe's own, on the cap midline. */
    margin-inline: 0.34em 0.12em;
    animation: breathe 3.2s ease-in-out infinite;
  }

  /*
   * The status marker. Larger than the 10px label beside it on purpose: it is
   * the mark, and a mark shrunk under its floor to match the type would be a
   * smudge next to a line it is supposed to introduce.
   */
  .eyebrow :global(.status-dot) {
    --globe-size: 1rem;
    animation: breathe 3.2s ease-in-out infinite;
  }

  /* The global reduced-motion block clamps every animation to 0.01ms, which
     would leave the mark frozen at whatever opacity the first frame lands on.
     Hold it at full strength instead. */
  @media (prefers-reduced-motion: reduce) {
    .eyebrow :global(.status-dot),
    .services :global(.sep) {
      animation: none;
      opacity: 1;
    }
  }

  /*
   * Opacity only. The plain dots this replaced also pulsed a ring outward, which
   * was legible because a dot has no detail of its own; on a wound sphere the
   * ring reads as a second, blurrier copy of the silhouette.
   */
  @keyframes breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
