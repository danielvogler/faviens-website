---
interface Props {
  number?: string;
  heading: string;
  lead?: string;
}

const { number, heading, lead } = Astro.props;
---

<section class="px-6 md:px-10 pt-40 pb-16">
  <div class="mx-auto max-w-(--container-content)">
    {number && <p class="eyebrow text-accent-d mb-6">{number}</p>}
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-[-0.035em] leading-none">
      {heading}
    </h1>
    {
      lead && (
        <p class="mt-8 max-w-(--container-measure) text-lg md:text-xl text-grey leading-relaxed">
          {lead}
        </p>
      )
    }
  </div>
</section>
