# Copy to .env.local for local development. .env.local is gitignored.
# Production values are set via GitHub Actions repository secrets.

# SITE_URL is read by astro.config.mjs, which runs before the dotenv files are
# loaded, so setting it here has no effect. Export it in your shell instead:
#   SITE_URL=https://staging.example pnpm build
SITE_URL=https://faviens.com
CONTACT_EMAIL=info@faviens.com
