---
import MarkGlobe from '~/components/marks/MarkGlobe.astro';
import { t, type Locale } from '~/i18n';

interface FooterLink {
  href: string;
  label: string;
}

interface Props {
  lang: Locale;
  // Empty until the imprint / privacy pages exist.
  legalLinks?: FooterLink[];
  contactEmail: string;
}

const { lang, legalLinks = [], contactEmail } = Astro.props;
const strings = t(lang);

const FOUNDED = 2026;
const currentYear = new Date().getFullYear();
const yearRange = currentYear > FOUNDED ? `${FOUNDED}–${currentYear}` : `${FOUNDED}`;
---

<!--
  The pronunciation respelling lives here by design: the handoff (§1) calls for
  it in the footer and in email signatures, so the two readings settle without
  anyone having to ask.
-->
<footer class="border-t border-hair mt-20">
  <div
    class="mx-auto max-w-(--container-content) px-6 md:px-10 py-14 grid gap-10 md:grid-cols-3 text-sm text-grey"
  >
    <div class="space-y-3 border-t border-hair pt-5">
      <p class="lockup text-accent-d">{strings.footer.pronunciationLabel}</p>
      <p>
        {strings.footer.pronunciation}
        <span class="text-ink/50">{strings.footer.pronunciationIpa}</span>
      </p>
    </div>

    <div class="space-y-3 border-t border-hair pt-5">
      <p class="lockup text-accent-d">{strings.footer.contact}</p>
      <p><a href={`mailto:${contactEmail}`} class="link-underline">{contactEmail}</a></p>
      <p>{strings.footer.location}</p>
    </div>

    {
      legalLinks.length > 0 && (
        <div class="space-y-3 border-t border-hair pt-5">
          <p class="lockup text-accent-d">{strings.footer.legal}</p>
          {/*
            The list marker is the mark, at the `dot` band. Tailwind's preflight
            leaves a list unmarked, so this list read as three loose lines; a
            CSS `list-style-image` would have taken a second copy of the artwork
            as a data URI and put a colour back into a component, which the
            palette rule forbids. An element in the row is the marker, and it is
            aria-hidden, because the list already announces itself as a list.
          */}
          <ul class="legal space-y-1.5">
            {legalLinks.map((l) => (
              <li class="flex items-baseline gap-2.5">
                <MarkGlobe variant="dot" class="marker" />
                <a href={l.href} class="link-underline">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="mx-auto max-w-(--container-content) px-6 md:px-10 pb-10 text-xs text-grey">
    © {yearRange} Faviens. {strings.footer.rights}
  </div>
</footer>

<style>
  /* `:global` under a scoped ancestor: Astro's scope attribute lands on this
     file's own elements, not on an `img` that MarkGlobe rendered, so a bare
     `.marker` would match nothing. `items-baseline` puts the marker's bottom
     edge on the text baseline, and the nudge lifts it onto the x-height. */
  .legal :global(.marker) {
    --globe-size: 1rem;
    /* `align-items: baseline` puts the marker's bottom edge on the text
       baseline; this lifts its centre onto the cap midline, the same rule
       MarkGlobe applies inline. */
    position: relative;
    top: calc(var(--globe-size) / 2 - var(--globe-cap) / 2);
    flex: none;
  }
</style>
