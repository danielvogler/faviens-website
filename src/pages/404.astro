---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import { getHomeHref, t } from '~/i18n';

const lang = 'de' as const;
const strings = t(lang).pages.notFound;
---

<BaseLayout title={strings.title} description={strings.lead} lang={lang}>
  <PageHeader heading={strings.heading} lead={strings.lead} />

  <Section>
    <a
      href={getHomeHref(lang)}
      class="link-underline text-lg text-ink hover:text-accent transition-colors"
    >
      {strings.back} →
    </a>
  </Section>
</BaseLayout>
