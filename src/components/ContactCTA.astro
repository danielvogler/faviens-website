---
import { t, type Locale } from '~/i18n';

interface Props {
  lang: Locale;
  contactEmail: string;
}

const { lang, contactEmail } = Astro.props;
const copy = t(lang).cta;
---

<!--
  Restraint over a CTA block: an email address set as a heading, one hairline
  above it. No button, no gradient panel, no second accent event.
-->
<section id="kontakt" class="relative px-6 md:px-10 py-20 md:py-28 border-t border-hair">
  <div class="mx-auto max-w-(--container-content)">
    <p class="eyebrow text-accent-d">{copy.eyebrow}</p>
    <a
      href={`mailto:${contactEmail}`}
      class="inline-block mt-6 text-2xl md:text-4xl font-semibold tracking-[-0.01em] hover:text-accent-d transition-colors"
    >
      {contactEmail}
    </a>
  </div>
</section>
