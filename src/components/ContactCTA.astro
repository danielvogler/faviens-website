---
import { t, type Locale } from '~/i18n';

interface Props {
  lang: Locale;
  contactHref: string;
}

const { lang, contactHref } = Astro.props;
const copy = t(lang).cta;
---

<section class="px-6 md:px-10 py-32 border-t border-rule bg-paper">
  <div class="mx-auto max-w-(--container-content)">
    <p class="text-sm tracking-wider uppercase text-muted">{copy.eyebrow}</p>
    <h2 class="mt-4 text-4xl md:text-6xl tracking-tighter font-medium max-w-3xl">
      {copy.headline}
    </h2>
    <a
      href={contactHref}
      class="inline-flex items-center mt-10 text-lg md:text-xl tracking-tight border-b-2 border-ink hover:border-accent hover:text-accent transition-colors pb-1"
    >
      {copy.label}
    </a>
  </div>
</section>
