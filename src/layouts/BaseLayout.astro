---
import BaseHead from '~/components/BaseHead.astro';
import Schema from '~/components/Schema.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import LanguageSwitcher from '~/components/LanguageSwitcher.astro';
import NodeField from '~/components/NodeField.astro';
import { getLegalLinks, t, type Locale } from '~/i18n';
import { CONTACT_EMAIL } from '~/data/company';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  /**
   * The node field behind the page. `quiet` everywhere by default; the legal
   * pages pass `off`, since a page of running text does not need atmosphere
   * behind it and the field would compete with the measure.
   */
  background?: 'off' | 'quiet' | 'active';
}

const { title, description, lang = 'de', background = 'quiet' } = Astro.props;

const strings = t(lang);
const legalLinks = getLegalLinks(lang);
---

<!doctype html>
<html lang={lang === 'de' ? 'de-CH' : 'en'}>
  <head>
    <BaseHead title={title} description={description} lang={lang} />
    <Schema lang={lang} />
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-ink focus:text-paper focus:px-3 focus:py-2 focus:text-sm"
    >
      {strings.a11y.skipToContent}
    </a>
    <NodeField intensity={background} />
    <!-- The field is fixed at z-0, so everything that is content sits above it
         in its own stacking context rather than relying on paint order. -->
    <div class="relative z-10">
      <Header lang={lang}>
        <LanguageSwitcher slot="language-switcher" lang={lang} />
      </Header>
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} legalLinks={legalLinks} contactEmail={CONTACT_EMAIL} />
    </div>
  </body>
</html>
