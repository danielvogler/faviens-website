---
/*
 * The agentic node field: a graph of nodes drifting across the full width of
 * the page, linking when they come near each other, with hubs that link further
 * than the rest and signals that travel the edges between them.
 *
 * Canvas rather than SVG or CSS. At the density below a frame is a few hundred
 * line segments and a few hundred distance tests, which canvas does in well
 * under a millisecond. SVG would make each of those a live DOM node with layout
 * attached, and CSS cannot draw the edges at all: the whole point is the link
 * between two moving points, which is geometry, not styling.
 *
 * Three things carry the density without turning into noise:
 *
 *   - Link distance is set against node spacing, not chosen. A mesh only reads
 *     as a mesh when the link distance is roughly 1.4x the mean spacing between
 *     nodes. Below that ratio the nodes are mostly unconnected dots, which is
 *     what the first version of this got wrong.
 *   - Depth. Every node gets one, and it scales the node's size, its speed and
 *     the opacity of everything it touches. A flat field at this count is
 *     static; a layered one reads as depth and holds the eye.
 *   - Hubs. A handful of nodes link at twice the distance of the rest, so the
 *     graph has centres rather than being an even lattice, and signals leave
 *     from them. That is the difference between a particle background and
 *     something that looks like a system.
 *
 * Guardrails, all of them deliberate:
 *   - prefers-reduced-motion draws a single static frame and never starts the
 *     loop. The field is a constellation either way; only the drift is lost.
 *   - The loop stops when the tab is hidden and when the field scrolls out of
 *     view, so a backgrounded landing page costs nothing.
 *   - Device pixel ratio is capped at 2.
 *   - Edges and nodes are batched into a handful of paths by opacity, so a
 *     frame is ~10 draw calls rather than one per edge.
 *   - Density is derived from viewport area, so a phone runs a fifth of the
 *     nodes rather than the same count squeezed into a tenth of the space.
 *   - Colour comes from --field-* in global.css, so a palette change moves the
 *     field with it and there is no colour of any kind hardcoded here.
 *   - aria-hidden and pointer-events: none. It is decoration and it must never
 *     be reachable, focusable or announced.
 */
interface Props {
  /**
   * `quiet` is the site setting. `active` is roughly half again the density and
   * twice the traffic, for a screen with no content on it. `off` renders the
   * element but draws nothing, so the setting can be switched at runtime
   * without a reload.
   */
  intensity?: 'off' | 'quiet' | 'active';
  class?: string;
}

const { intensity = 'quiet', class: className = '' } = Astro.props;
---

<canvas
  class:list={['node-field', className]}
  data-node-field
  data-intensity={intensity}
  aria-hidden="true"></canvas>

<style>
  .node-field {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /*
     * The field spans the whole width and is only held back, gently, from the
     * band the wordmark and the lead sit in. An earlier version cut the middle
     * to a fifth, which emptied out exactly the part of the screen anyone
     * actually looks at. 0.62 is enough to keep 18px copy comfortable and not
     * enough to leave a hole.
     */
    --field-hold: 0.62;
    -webkit-mask-image: radial-gradient(
      ellipse 78% 62% at 42% 46%,
      rgba(0, 0, 0, var(--field-hold)),
      rgba(0, 0, 0, 1) 78%
    );
    mask-image: radial-gradient(
      ellipse 78% 62% at 42% 46%,
      rgba(0, 0, 0, var(--field-hold)),
      rgba(0, 0, 0, 1) 78%
    );
  }
</style>

<script>
  interface FieldSettings {
    /** One node per this many square pixels of viewport. */
    readonly area: number;
    readonly minNodes: number;
    readonly maxNodes: number;
    /** Pixels per second, before depth scales it. */
    readonly speed: number;
    /**
     * Link distance as a multiple of the mean spacing between nodes, rather
     * than a pixel value: the pixel value that reads correctly at 1440px is the
     * wrong one on a phone. 1.4 gives a mesh that is connected without being a
     * lattice.
     */
    readonly reach: number;
    readonly edgeAlpha: number;
    readonly nodeAlpha: number;
    /** One node in this many is a hub. */
    readonly hubEvery: number;
    /** Mean seconds between signals. */
    readonly signalEvery: number;
    readonly maxSignals: number;
  }

  const SETTINGS: Record<'quiet' | 'active', FieldSettings> = {
    quiet: {
      area: 9200,
      minNodes: 34,
      maxNodes: 165,
      speed: 15,
      reach: 1.4,
      edgeAlpha: 0.3,
      nodeAlpha: 0.5,
      hubEvery: 14,
      signalEvery: 1.3,
      maxSignals: 6,
    },
    active: {
      area: 6200,
      minNodes: 48,
      maxNodes: 250,
      speed: 24,
      reach: 1.45,
      edgeAlpha: 0.38,
      nodeAlpha: 0.62,
      hubEvery: 11,
      signalEvery: 0.6,
      maxSignals: 12,
    },
  };

  const MAX_DPR = 2;
  const SIGNAL_SECONDS = 1.3;
  const FLASH_SECONDS = 0.75;
  /** Length of a signal's tail, as a fraction of the edge it is travelling. */
  const TRAIL = 0.16;
  /** Opacity steps that edges and nodes are batched into. More steps means a
   *  smoother falloff and more draw calls; six is past the point where the
   *  banding is visible on a hairline. */
  const STEPS = 6;
  /** A long first frame, or a tab resumed after an hour, must not teleport
   *  every node across the screen. */
  const MAX_FRAME_SECONDS = 1 / 20;

  interface Node {
    x: number;
    y: number;
    /** Direction of travel. Kept as an angle so the wander below can nudge it
     *  without also changing the speed. */
    angle: number;
    speed: number;
    /** Radians per second of drift in the heading. Straight lines read as
     *  ballistics; a slow curve reads as drift. */
    spin: number;
    /** 0 is far, faint, small and slow. 1 is near, brighter, larger, faster. */
    depth: number;
    hub: boolean;
  }

  interface Signal {
    from: Node;
    to: Node;
    /** 0 at the source, 1 at the target. */
    progress: number;
  }

  interface Flash {
    node: Node;
    /** Seconds remaining. */
    life: number;
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const random = (min: number, max: number) => min + Math.random() * (max - min);

  const startField = (canvas: HTMLCanvasElement) => {
    const context = canvas.getContext('2d');
    if (!context) return;

    let settings = SETTINGS.quiet;
    let nodes: Node[] = [];
    let signals: Signal[] = [];
    let flashes: Flash[] = [];
    let width = 0;
    let height = 0;
    let reach = 0;
    let frame = 0;
    let lastTime = 0;
    let untilNextSignal = 0;
    let onScreen = true;

    const isOff = () => canvas.dataset.intensity === 'off';

    /*
     * Read once, at start. The tokens are triplets rather than hex so an alpha
     * can be composed onto them per edge, per node and per frame.
     *
     * There is no fallback colour on purpose. A fallback here would be the one
     * place in the repository where a palette value is written twice, and it
     * would go stale the first time the palette changed. The only way these
     * come back empty is a stylesheet that did not load, in which case the page
     * has no design to decorate and the field should stay off.
     */
    const styles = getComputedStyle(canvas);
    const colour = (name: string) => {
      const parts = styles
        .getPropertyValue(name)
        .trim()
        .split(/[\s,]+/)
        .filter(Boolean);
      return parts.length === 3 ? parts.join(', ') : null;
    };
    const EDGE = colour('--field-edge');
    const NODE = colour('--field-node');
    const SIGNAL = colour('--field-signal');
    if (!EDGE || !NODE || !SIGNAL) return;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const makeNode = (index: number): Node => ({
      x: random(0, width),
      y: random(0, height),
      angle: random(0, Math.PI * 2),
      speed: random(0.75, 1.35),
      spin: random(-0.16, 0.16),
      depth: random(0.3, 1),
      hub: index % settings.hubEvery === 0,
    });

    const populate = () => {
      const target = Math.min(
        settings.maxNodes,
        Math.max(settings.minNodes, Math.round((width * height) / settings.area)),
      );
      // Kept, not rebuilt: on a resize or a settings change the existing nodes
      // stay where they are and the field is only topped up or trimmed, so the
      // composition never restarts under the reader.
      while (nodes.length > target) nodes.pop();
      while (nodes.length < target) nodes.push(makeNode(nodes.length));

      // Link distance follows the spacing the nodes actually ended up with, so
      // the mesh has the same connectedness on a phone as on a display.
      const spacing = Math.sqrt((width * height) / Math.max(nodes.length, 1));
      reach = spacing * settings.reach;

      signals = signals.filter((s) => nodes.includes(s.from) && nodes.includes(s.to));
      flashes = flashes.filter((f) => nodes.includes(f.node));
    };

    const applySettings = () => {
      settings = canvas.dataset.intensity === 'active' ? SETTINGS.active : SETTINGS.quiet;
      nodes.forEach((node, index) => {
        node.hub = index % settings.hubEvery === 0;
      });
      populate();
    };

    /** Hubs reach further, which is what makes them hubs rather than just
     *  bigger dots. */
    const reachOf = (a: Node, b: Node) => (a.hub || b.hub ? reach * 1.9 : reach);

    const step = (seconds: number) => {
      for (const node of nodes) {
        node.angle += node.spin * seconds;
        const speed = node.speed * settings.speed * (0.55 + node.depth * 0.75);
        node.x += Math.cos(node.angle) * speed * seconds;
        node.y += Math.sin(node.angle) * speed * seconds;

        // Reflect rather than wrap: a node crossing an edge and reappearing on
        // the far side snaps every link it had, which reads as a glitch.
        if (node.x < 0 || node.x > width) {
          node.angle = Math.PI - node.angle;
          node.x = Math.min(Math.max(node.x, 0), width);
        }
        if (node.y < 0 || node.y > height) {
          node.angle = -node.angle;
          node.y = Math.min(Math.max(node.y, 0), height);
        }
      }

      for (const signal of signals) signal.progress += seconds / SIGNAL_SECONDS;
      for (const arrived of signals.filter((s) => s.progress >= 1)) {
        flashes.push({ node: arrived.to, life: FLASH_SECONDS });
      }
      signals = signals.filter((signal) => signal.progress < 1);

      for (const flash of flashes) flash.life -= seconds;
      flashes = flashes.filter((flash) => flash.life > 0);

      untilNextSignal -= seconds;
      if (untilNextSignal <= 0) {
        untilNextSignal = random(settings.signalEvery * 0.4, settings.signalEvery * 1.6);
        if (signals.length < settings.maxSignals) emitSignal();
      }
    };

    /**
     * Signals travel an edge that exists, so they read as traffic on the graph
     * rather than as sparks crossing empty paper, and they leave from a hub
     * where there is one to leave from.
     */
    const emitSignal = () => {
      const hubs = nodes.filter((node) => node.hub);
      const pool = hubs.length && Math.random() < 0.72 ? hubs : nodes;
      const from = pool[Math.floor(Math.random() * pool.length)];
      if (!from) return;

      const linked: Node[] = [];
      for (const node of nodes) {
        if (node === from) continue;
        const dx = node.x - from.x;
        const dy = node.y - from.y;
        const edge = reachOf(from, node);
        if (dx * dx + dy * dy < edge * edge) linked.push(node);
      }

      const to = linked[Math.floor(Math.random() * linked.length)];
      if (to) signals.push({ from, to, progress: 0 });
    };

    /** Rounds an opacity to one of STEPS levels, so everything drawn at the
     *  same level can share a single path and a single draw call. */
    const bucketOf = (alpha: number) => Math.min(STEPS - 1, Math.max(0, Math.round(alpha * STEPS)));

    const draw = () => {
      context.clearRect(0, 0, width, height);
      if (isOff()) return;

      const edgePaths = Array.from({ length: STEPS }, () => new Path2D());
      const nodePaths = Array.from({ length: STEPS }, () => new Path2D());

      for (let i = 0; i < nodes.length; i += 1) {
        const a = nodes[i]!;
        for (let j = i + 1; j < nodes.length; j += 1) {
          const b = nodes[j]!;
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const squared = dx * dx + dy * dy;
          // Squared first: the sqrt is only paid for pairs that are actually
          // close enough to draw, which is a small fraction of the pairs.
          const edge = a.hub || b.hub ? reach * 1.9 : reach;
          if (squared >= edge * edge) continue;

          // Fades in as the two approach, so an edge never pops into existence,
          // and the nearer of the two nodes sets how solid it is.
          const strength = 1 - Math.sqrt(squared) / edge;
          const alpha = strength * settings.edgeAlpha * (0.4 + Math.min(a.depth, b.depth) * 0.6);
          const path = edgePaths[bucketOf(alpha)]!;
          path.moveTo(a.x, a.y);
          path.lineTo(b.x, b.y);
        }

        const radius = a.hub ? 1.7 + a.depth * 1.5 : 0.7 + a.depth * 1.2;
        const alpha = settings.nodeAlpha * (0.35 + a.depth * 0.65) * (a.hub ? 1.25 : 1);
        const path = nodePaths[bucketOf(alpha)]!;
        path.moveTo(a.x + radius, a.y);
        path.arc(a.x, a.y, radius, 0, Math.PI * 2);
      }

      context.lineWidth = 1;
      for (let level = 1; level < STEPS; level += 1) {
        const alpha = level / STEPS;
        context.strokeStyle = `rgba(${EDGE}, ${alpha.toFixed(3)})`;
        context.stroke(edgePaths[level]!);
      }
      for (let level = 1; level < STEPS; level += 1) {
        const alpha = level / STEPS;
        context.fillStyle = `rgba(${NODE}, ${alpha.toFixed(3)})`;
        context.fill(nodePaths[level]!);
      }

      // Hub rings, drawn once each: too few to be worth batching, and each one
      // wants its own radius.
      for (const node of nodes) {
        if (!node.hub) continue;
        context.strokeStyle = `rgba(${NODE}, ${(0.16 * node.depth).toFixed(3)})`;
        context.beginPath();
        context.arc(node.x, node.y, 5 + node.depth * 4, 0, Math.PI * 2);
        context.stroke();
      }

      for (const flash of flashes) {
        // Expands and fades as it goes, so an arrival is a ripple rather than a
        // dot appearing.
        const t = 1 - flash.life / FLASH_SECONDS;
        context.strokeStyle = `rgba(${SIGNAL}, ${(0.5 * (1 - t)).toFixed(3)})`;
        context.beginPath();
        context.arc(flash.node.x, flash.node.y, 2 + t * 11, 0, Math.PI * 2);
        context.stroke();
      }

      for (const signal of signals) {
        const dx = signal.to.x - signal.from.x;
        const dy = signal.to.y - signal.from.y;
        // Brightest mid-flight, gone at both ends, so departure and arrival are
        // not two hard edges.
        const fade = Math.sin(signal.progress * Math.PI);
        const x = signal.from.x + dx * signal.progress;
        const y = signal.from.y + dy * signal.progress;

        const tail = Math.max(0, signal.progress - TRAIL);
        context.strokeStyle = `rgba(${SIGNAL}, ${(fade * 0.55).toFixed(3)})`;
        context.lineWidth = 1.4;
        context.beginPath();
        context.moveTo(signal.from.x + dx * tail, signal.from.y + dy * tail);
        context.lineTo(x, y);
        context.stroke();

        context.fillStyle = `rgba(${SIGNAL}, ${fade.toFixed(3)})`;
        context.beginPath();
        context.arc(x, y, 2.1, 0, Math.PI * 2);
        context.fill();
      }
      context.lineWidth = 1;
    };

    const tick = (time: number) => {
      frame = 0;
      const seconds = Math.min((time - lastTime) / 1000, MAX_FRAME_SECONDS);
      lastTime = time;
      step(seconds);
      draw();
      schedule();
    };

    const schedule = () => {
      if (frame || document.hidden || !onScreen || isOff() || reduceMotion.matches) return;
      frame = window.requestAnimationFrame(tick);
    };

    const stop = () => {
      if (!frame) return;
      window.cancelAnimationFrame(frame);
      frame = 0;
    };

    const restart = () => {
      lastTime = performance.now();
      schedule();
    };

    resize();
    applySettings();
    draw();
    restart();

    // A settings change is an attribute change, so the intensity can be swapped
    // at runtime without rebuilding the field or reloading the page.
    new MutationObserver(() => {
      applySettings();
      draw();
      restart();
    }).observe(canvas, { attributeFilter: ['data-intensity'] });

    let resizeFrame = 0;
    window.addEventListener(
      'resize',
      () => {
        window.cancelAnimationFrame(resizeFrame);
        resizeFrame = window.requestAnimationFrame(() => {
          resize();
          populate();
          draw();
        });
      },
      { passive: true },
    );

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : restart()));

    new IntersectionObserver((entries) => {
      onScreen = entries.some((entry) => entry.isIntersecting);
      if (onScreen) restart();
      else stop();
    }).observe(canvas);

    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) stop();
      else restart();
    });
  };

  document.querySelectorAll<HTMLCanvasElement>('[data-node-field]').forEach(startField);
</script>
