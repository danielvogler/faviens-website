---
/*
 * The wound-string globe, as an image.
 *
 * The artwork is generated by src/lib/globe.mjs into public/mark*.svg at
 * predev and prebuild, not inlined here. Inlining would put 79 KB of
 * coordinates into the markup for the hero alone, again for the header, and
 * again for every bullet on the page, none of it cacheable or shared; as a file
 * it is one request for the whole site.
 *
 * `variant` is a size band, not a style. The real mark holds down to about
 * 28px; below that its strands fall under a pixel and it rasterises as a soft
 * disc, so a marker at bullet size uses the reduced drawing instead. Picking
 * the wrong band is visible immediately, as a pale disc or as a coarse
 * scribble. The bands are documented with VARIANTS in src/lib/globe.mjs.
 *
 * Decoration by default. The globe never carries the name on its own here,
 * because the wordmark is always beside it, so it takes an empty alt and the
 * link around it carries the label. Pass `label` only where it stands alone.
 */
import { CAP } from '~/lib/type.mjs';

interface Props {
  /** `dot` from 13 to 20px, `full` from 28px up. */
  variant?: 'dot' | 'full';
  /** Rendered size, any CSS length. Also sets the intrinsic size. */
  size?: string;
  /** Set only where the mark stands alone and has to carry the name. */
  label?: string;
  class?: string;
}

const { variant = 'full', size, label = '', class: className = '' } = Astro.props;

const FILE = {
  dot: '/mark-dot.svg',
  full: '/mark.svg',
} as const;
---

<img
  src={FILE[variant]}
  alt={label}
  width="1"
  height="1"
  decoding="async"
  class:list={['mark-globe', className]}
  style={`--globe-cap: ${CAP}em${size ? `; --globe-size: ${size}` : ''}`}
  aria-hidden={label ? undefined : 'true'}
/>

<style>
  /*
   * Square, from one custom property, so a caller sets one value and the aspect
   * cannot drift. The width and height attributes are 1 and 1 rather than the
   * pixel size: they are there to give the box an aspect ratio before the file
   * arrives, and the real size is always the property.
   */
  .mark-globe {
    display: inline-block;
    width: var(--globe-size, 1.5rem);
    height: var(--globe-size, 1.5rem);
    /*
     * Centred on the cap midline, the same line the lockup's circle and the
     * wordmark's bar are centred on, so every mark on the page sits at one
     * height. `vertical-align` puts an inline-block's BOTTOM edge that far from
     * the baseline, so half a cap up and half the mark's own height back down
     * lands its centre there.
     *
     * The default of resting on the baseline is what makes a round mark read as
     * a full stop rather than as a separator between two words.
     */
    vertical-align: calc(var(--globe-cap) / 2 - var(--globe-size, 1.5rem) / 2);
  }
</style>
