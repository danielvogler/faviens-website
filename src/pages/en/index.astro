---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { t } from '~/i18n';
import { CONTACT_EMAIL } from '~/data/company';

const lang = 'en' as const;
const strings = t(lang);
---

<BaseLayout
  title={strings.pages.home.title}
  description={strings.pages.home.description}
  lang={lang}
>
  <Hero
    descriptor={strings.hero.descriptor}
    services={strings.hero.services}
    status={strings.hero.status}
    lead={strings.hero.lead}
  />

  <ContactCTA lang={lang} contactEmail={CONTACT_EMAIL} />
</BaseLayout>
