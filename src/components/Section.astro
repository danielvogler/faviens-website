---
/*
 * Numbered section — handoff §6: `01 / 02 / 03` in a 2.5rem left column,
 * heading beside it, hairline rule beneath. The number is the section's one
 * gold event, set in --gold-d because it is far below 18px (handoff §4).
 */
interface Props {
  number?: string;
  heading?: string;
  class?: string;
}

const { number, heading, class: className = '' } = Astro.props;
---

<section class:list={['px-6 md:px-10 py-20 md:py-28', className]}>
  <div class="mx-auto max-w-(--container-content)">
    {
      (number || heading) && (
        <div class="grid gap-x-10 gap-y-2 md:grid-cols-[2.5rem_1fr] items-baseline border-b border-hair pb-5">
          {number && <p class="eyebrow text-gold-d">{number}</p>}
          {heading && (
            <h2 class="text-2xl md:text-3xl font-semibold tracking-[-0.01em]">{heading}</h2>
          )}
        </div>
      )
    }

    <!-- The body only takes the number column's indent when there is a number
         to align under; otherwise it stays flush with the container edge. -->
    <div class:list={['grid gap-x-10', number && 'md:grid-cols-[2.5rem_1fr]']}>
      {number && <div aria-hidden="true" />}
      <div class:list={[(number || heading) && 'pt-8']}>
        <slot />
      </div>
    </div>
  </div>
</section>
