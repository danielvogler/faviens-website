---
import MarkLockup from '~/components/marks/MarkLockup.astro';
import { getHomeHref, type Locale } from '~/i18n';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  lang: Locale;
  // Empty while the site is a placeholder. Populate once real pages exist:
  // the markup below already handles it.
  navLinks?: NavLink[];
}

const { lang, navLinks = [] } = Astro.props;
const homeHref = getHomeHref(lang);
---

<!--
  The header mark is the full lockup, globe included, so the two logos on the
  screen are the same object. That is a deliberate departure from the handoff's
  one-accent-event-per-screen rule (§6): the identity is the doubling, and a
  header that drops half of it reads as a different logo.

  The mark is the real one, all sixty strands, and the wordmark is set at 30px
  so that it can be. The globe is 0.948 of the type, so 30px is what puts it at
  28px, which is the size the strands start reading at. At the 20px this header
  used to be, the globe was 19px and the only options were a soft pink disc or a
  coarse eight-strand scribble, neither of which is the logo.

  Hairline, not shadow, separates the header once scrolled.
-->
<header
  data-site-header
  class="fixed top-0 inset-x-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-300"
>
  <div
    class="mx-auto max-w-(--container-content) px-6 md:px-10 py-6 flex items-center justify-between"
  >
    <a href={homeHref} class="hover:text-accent-d transition-colors" aria-label="faviens, home">
      <MarkLockup class="text-[1.875rem]" variant="full" />
    </a>

    {
      navLinks.length > 0 && (
        <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
          {navLinks.map((link) => (
            <a href={link.href} class="text-sm text-ink/80 hover:text-ink link-underline">
              {link.label}
            </a>
          ))}
        </nav>
      )
    }

    <slot name="language-switcher" />
  </div>
</header>

<style>
  header[data-site-header] {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  header[data-site-header][data-scrolled='true'] {
    background-color: color-mix(in oklab, var(--color-paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom-color: var(--color-hair);
  }
</style>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const update = () => {
      header.setAttribute('data-scrolled', String(window.scrollY > 40));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
