---
/*
 * The mark. Capitals, set in ink, with the A and the I in the accent. Nothing
 * else: no echo, no rule, no motion.
 *
 * The two letters are the AI hidden in the name, one letter apart, and colour
 * alone is what points at them. It is the quietest device in the sheet and the
 * only one that needs no explanation, no motion and no second impression to
 * work: the whole idea is legible in one still frame at any size that holds
 * seven letters.
 *
 * The capitals are `text-transform`, not typed. The page text stays "faviens",
 * so a crawler, a screen reader and anyone copying the name out of the page get
 * the name rather than the styling. Typed as literal capitals the site would be
 * quoted as "FAVIENS" everywhere, which is a different name.
 *
 * The letters are built as a string and injected rather than mapped in the
 * template: a line break between two letter spans is a text node, and a text
 * node is a space, so a reformat could otherwise turn the mark into
 * "F A V I E N S". The content is the fixed array below, so there is nothing to
 * escape. `:global()` reaches the injected spans, which carry no scoping
 * attribute of their own.
 */
interface Props {
  /** Sets the mark's size. */
  class?: string;
  /**
   * Ink only. The accent is the whole mark here, so this reduces it to a
   * wordmark with nothing said, and is for one-accent-event compositions and
   * for grounds the accent cannot survive.
   */
  mono?: boolean;
}

const { class: className = '', mono = false } = Astro.props;

/** The a and the i, in that order and one letter apart, are the AI. */
const LETTERS = ['f', 'a', 'v', 'i', 'e', 'n', 's'];
const AI = new Set(['a', 'i']);
const letters = LETTERS.map((letter) =>
  AI.has(letter) ? `<span class="ai">${letter}</span>` : letter,
).join('');
---

<span class:list={['mark-caps-ai', mono && 'mono', className]} set:html={letters} />

<style>
  .mark-caps-ai {
    display: inline-block;
    font-weight: 800;
    /* Capitals are optically larger and need less negative tracking than the
       lowercase's -0.035em to stay open. */
    letter-spacing: -0.012em;
    line-height: 1;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .mark-caps-ai :global(.ai) {
    color: var(--color-accent);
  }

  /*
   * On a dark ground the ink letters have to invert, and the accent holds: it
   * measures 4.8:1 against the ink, which is the one place this palette is
   * stronger than the gold it replaced.
   */
  :global([data-ground='ink']) .mark-caps-ai {
    color: var(--color-paper);
  }
</style>
